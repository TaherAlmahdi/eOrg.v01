{
  "name": "eOrg",
  "version": "0.0.1",
  "private": true,
  "scripts": {
    "dev": "next dev --webpack",
    "build": "cross-env NODE_OPTIONS=\"--max-old-space-size=4096\" next build --webpack",
    "start": "next start",
    "lint": "eslint",
    "preview": "opennextjs-cloudflare build && opennextjs-cloudflare preview",
    "deploy": "opennextjs-cloudflare build && opennextjs-cloudflare deploy",
    "cf-typegen": "wrangler types --env-interface CloudflareEnv cloudflare-env.d.ts",
    "normalize-bn": "tsx scripts/normalize-bn.ts",
    "normalize-bn:write": "tsx scripts/normalize-bn.ts --write",
    "sync-assets": "tsx scripts/sync-assets-to-r2.ts",
    "sync-assets:dry": "tsx scripts/sync-assets-to-r2.ts --dry-run",
    "optimize-images": "tsx scripts/optimize-images.ts",
    "sync-stories": "tsx scripts/sync-stories.ts",
    "sync-stories:dry": "tsx scripts/sync-stories.ts --dry-run"
  },
  "dependencies": {
    "@ducanh2912/next-pwa": "^10.2.9",
    "@supabase/supabase-js": "^2.118.0",
    "aos": "^2.3.4",
    "gray-matter": "^4.0.3",
    "lucide-react": "^1.8.0",
    "mime-types": "^3.0.2",
    "next": "^16.2.10",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "react-markdown": "^10.1.0",
    "rehype-raw": "^7.0.0",
    "rehype-slug": "^6.0.0",
    "remark-gfm": "^4.0.1"
  },
  "devDependencies": {
    "@aws-sdk/client-s3": "^3.1149.0",
    "@opennextjs/cloudflare": "^1.9.0",
    "@tailwindcss/postcss": "^4",
    "@tailwindcss/typography": "^0.5.19",
    "@types/aos": "^3.0.8",
    "@types/mime-types": "^3.0.1",
    "@types/node": "^20.19.43",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "cross-env": "^10.1.0",
    "dotenv": "^18.0.7",
    "eslint": "^9",
    "eslint-config-next": "16.2.4",
    "sharp": "^0.35.5",
    "tailwindcss": "^4",
    "tsx": "^4.23.13",
    "typescript": "^5.9.3",
    "wrangler": "^4.149.0"
  },
  "allowScripts": {
    "unrs-resolver@1.11.1": true
  }
}
